# Local research configuration. Copy to .env and fill private values.

# Raspberry Pi access, used by operators/scripts outside this repo.
AGAVE_RPI_HOST=pa-bioiot.local
AGAVE_RPI_USER=bioiot

# Camera connection. Keep credentials out of git.
AGAVE_CAMERA_IP=192.168.1.248
AGAVE_CAMERA_USER=admin
AGAVE_CAMERA_PASSWORD=change-me
AGAVE_CAMERA_RTSP=rtsp://admin:change-me@192.168.1.248:554/cam/realmonitor?channel=1&subtype=1

# Model and runtime defaults.
AGAVE_MODEL_PATH=runs/detect/agave_experiments/yolo26s_sgd_cos_slow_120e/weights/best.pt
AGAVE_INFERENCE_DEVICE=cpu
AGAVE_INFERENCE_IMGSZ=320
AGAVE_INFERENCE_CONF=0.30
AGAVE_INFERENCE_IOU=0.40
